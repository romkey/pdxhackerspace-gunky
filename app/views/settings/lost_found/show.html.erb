<h2>Settings: Lost+Found</h2>

<div class="row">
  <div class="col-md-8">
    <%= form_with(model: @lost_found_setting, url: settings_lost_found_path, method: :patch) do |f| %>
      <% if @lost_found_setting.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @lost_found_setting.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :hold_days, "Hold period (days)", class: "form-label" %>
        <%= f.number_field :hold_days, class: "form-control", min: LostFoundSetting::HOLD_DAYS_RANGE.min, max: LostFoundSetting::HOLD_DAYS_RANGE.max %>
        <div class="form-text">
          Unclaimed items stay in lost+found for this many days before being promoted to a Gunky giveaway.
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :pickup_days, "Pickup deadline (days)", class: "form-label" %>
        <%= f.number_field :pickup_days, class: "form-control", min: LostFoundSetting::PICKUP_DAYS_RANGE.min, max: LostFoundSetting::PICKUP_DAYS_RANGE.max %>
        <div class="form-text">
          After someone claims an item, they have this many days to pick it up before it is promoted to Gunky.
        </div>
      </div>

      <div class="alert alert-secondary small mb-4">
        <strong>Domains.</strong> Set <code>GUNKY_URL</code> and <code>LOST_FOUND_URL</code> in the environment.
        Uploads on the lost+found domain enter the hold period; the gunky domain skips it.
        Set <code>SLACK_LOST_FOUND_CHANNEL_ID</code> for the lost+found Slack channel.
      </div>

      <div class="d-flex gap-2">
        <%= f.submit "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
