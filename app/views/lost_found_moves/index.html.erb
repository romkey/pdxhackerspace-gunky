<div data-controller="select-list">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h1 class="mb-0">To move</h1>
      <p class="text-muted mb-0">Items promoted to Gunky that still need to be physically moved out of Lost+Found.</p>
    </div>
    <% if @items.any? %>
      <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary"
                data-select-list-target="selectButton"
                data-action="select-list#enter">Select</button>
        <button type="submit" form="dismiss-selected-form" class="btn btn-success d-none"
                data-select-list-target="dismissButton" disabled>Dismiss</button>
        <button type="button" class="btn btn-outline-secondary d-none"
                data-select-list-target="cancelButton"
                data-action="select-list#exit">Cancel</button>
      </div>
    <% end %>
  </div>

  <% if @items.any? %>
    <%= form_with url: dismiss_selected_lost_found_moves_path, method: :post, id: "dismiss-selected-form" do %>
    <% end %>

    <div class="list-group">
      <% @items.each do |item| %>
        <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div class="d-flex align-items-center gap-3">
            <%= check_box_tag "item_ids[]", item.id, false,
                  id: "item_ids_#{item.id}",
                  form: "dismiss-selected-form",
                  class: "form-check-input mt-0 d-none",
                  "aria-label": "Select #{item.display_description}",
                  data: { select_list_target: "checkbox", action: "select-list#update" } %>
            <div>
              <div class="fw-semibold"><%= link_to item.display_description, item_path(item) %></div>
              <div class="text-muted small">
                <%= item.location.presence || "No location" %>
                <% if item.lost_found_promoted_at.present? %>
                  &middot; Promoted <%= item.lost_found_promoted_at.strftime("%b %d, %Y") %>
                <% end %>
              </div>
            </div>
          </div>
          <div data-select-list-target="itemAction">
            <%= button_to "Dismiss",
                  dismiss_lost_found_move_path(item),
                  method: :post,
                  class: "btn btn-outline-success btn-sm",
                  title: "Mark as moved to Gunky" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <h4 class="text-muted">Nothing to move</h4>
      <p class="text-muted">Every promoted item has been moved to Gunky.</p>
    </div>
  <% end %>
</div>
