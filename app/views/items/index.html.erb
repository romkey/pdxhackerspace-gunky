<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="mb-0">Items</h1>
  <div class="d-flex flex-wrap gap-2">
    <%= button_to "Print all completed",
          print_completed_items_path,
          method: :post,
          class: "btn btn-outline-secondary",
          form_class: "d-inline" %>
    <%= link_to "Print all completed (browser)",
          print_completed_browser_items_path,
          class: "btn btn-outline-secondary",
          target: "_blank",
          rel: "noopener",
          data: { turbo: false } %>
    <%= link_to "New Item", new_item_path, class: "btn btn-primary" %>
  </div>
</div>

<div class="alert alert-light border mb-4" role="status">
  <div class="fw-semibold mb-2">Gunky stats</div>
  <div class="d-flex flex-wrap gap-3">
    <span><strong><%= @stats[:total] %></strong> total gunky'd</span>
    <span><strong><%= @stats[:new_homes] %></strong> new homes</span>
    <span><strong><%= @stats[:kept_for_space] %></strong> kept for space</span>
    <span><strong><%= @stats[:trashed] %></strong> trashed</span>
    <span><strong><%= @stats[:owners_found] %></strong> owners found</span>
    <span><strong><%= @stats[:cancelled] %></strong> cancelled</span>
  </div>
</div>

<ul class="nav nav-pills mb-4">
  <li class="nav-item">
    <%= link_to "All", items_path, class: "nav-link #{params[:disposition].blank? ? 'active' : ''}" %>
  </li>
  <% index_filter_tabs.each do |label, filter| %>
    <li class="nav-item">
      <%= link_to label, items_path(disposition: filter), class: "nav-link #{index_tab_active?(filter) ? 'active' : ''}" %>
    </li>
  <% end %>
</ul>

<% if @items.any? %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @items.each do |item| %>
      <div class="col">
        <div class="card h-100">
          <% if item.photo.attached? %>
            <%= image_tag item.photo.variant(resize_to_fill: [400, 300]), class: "card-img-top", alt: item.display_description.truncate(50) %>
          <% else %>
            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
              <span class="text-white-50 fs-4">No photo</span>
            </div>
          <% end %>
          <div class="card-body">
            <h5 class="card-title"><%= link_to item.display_description.truncate(60), item, class: "text-decoration-none" %></h5>
            <p class="card-text text-muted mb-1">
              <small><%= item.location.presence || "No location" %></small>
            </p>
            <span class="badge <%= disposition_badge_class(item.disposition) %>"><%= item_disposition_label(item) %></span>
            <% if item.pending? %>
              <span class="text-muted ms-1"><small><%= pending_vote_counts_line(item) %></small></span>
            <% end %>
            <% if item.expired? && item.pending? %>
              <span class="badge bg-warning text-dark">Expired</span>
            <% end %>
            <% if item.owned? %>
              <p class="mt-2 mb-0 text-muted">
                <small>Owned by <%= item.claimed_by %></small>
              </p>
              <div class="mt-2">
                <%= button_to "Disown",
                      disown_item_path(item),
                      method: :post,
                      class: "btn btn-outline-warning btn-sm",
                      form: { data: { turbo_confirm: "Reopen this giveaway and remove the owner claim?" } } %>
              </div>
            <% end %>

            <% if item.giveaway_cancelled? && item.normalized_cancellation_reason.present? %>
              <p class="mt-2 mb-0 text-muted">
                <small>Cancelled: <%= item.normalized_cancellation_reason %></small>
              </p>
            <% end %>

            <% if item.pending? %>
              <div class="mt-3 d-flex flex-wrap gap-2 align-items-start">
                <%= form_with url: cancel_giveaway_item_path(item), method: :post, class: "d-flex flex-wrap gap-2 align-items-center" do |f| %>
                  <%= f.text_field :cancellation_reason, class: "form-control form-control-sm", placeholder: "Reason (optional)", style: "max-width: 12rem;" %>
                  <%= f.submit "Cancel", class: "btn btn-outline-secondary btn-sm", data: { turbo_confirm: "Cancel this giveaway?" } %>
                <% end %>
                <%= form_with url: claim_ownership_item_path(item), method: :post, class: "d-flex flex-wrap gap-2 align-items-center" do |f| %>
                  <%= f.text_field :claimed_by, class: "form-control form-control-sm", placeholder: "Owner name", required: true, style: "max-width: 10rem;" %>
                  <%= f.submit "I Own This", class: "btn btn-outline-dark btn-sm" %>
                <% end %>
              </div>
            <% end %>

            <% if item.mine? && item.mine_voters_pending_pickup.any? %>
              <div class="mt-3">
                <h6 class="mb-2">Winners</h6>
                <% item.mine_voters_pending_pickup.each do |winner| %>
                  <div class="border rounded p-2 mb-2">
                    <div class="fw-semibold mb-2"><%= winner[:slack_username] %></div>
                    <div class="d-flex gap-2">
                      <%= button_to "Forfeit",
                        winner_forfeit_item_path(item, slack_user_id: winner[:slack_user_id]),
                        method: :post,
                        class: "btn btn-outline-danger btn-sm",
                        form: { data: { turbo_confirm: "Remove #{winner[:slack_username]} from Want winners?" } } %>
                      <%= button_to "Picked up",
                        winner_picked_up_item_path(item, slack_user_id: winner[:slack_user_id]),
                        method: :post,
                        class: "btn btn-outline-success btn-sm" %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="card-footer text-muted">
            <small>Expires: <%= item.expiration_date&.strftime("%b %d, %Y") || "N/A" %></small>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
  </div>
<% else %>
  <div class="text-center py-5">
    <h4 class="text-muted">No items found</h4>
    <p><%= link_to "Add the first item", new_item_path %></p>
  </div>
<% end %>
