<%= turbo_stream_from "item_#{@item.id}" %>

<div class="row">
  <div class="col-lg-6">
    <% if @item.photo.attached? %>
      <%= image_tag @item.photo.variant(resize_to_limit: [800, 600]), class: "img-fluid rounded mb-3", alt: @item.display_description.truncate(50) %>
    <% else %>
      <div class="bg-secondary rounded d-flex align-items-center justify-content-center mb-3" style="height: 300px;">
        <span class="text-white-50 fs-3">No photo</span>
      </div>
    <% end %>
  </div>

  <div class="col-lg-6">
    <%= render "items/description", item: @item %>

    <div class="item-print-actions">
      <h2 class="item-print-actions__title">Print this item</h2>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <%= button_to "Thermal printer",
              print_item_path(@item),
              method: :post,
              class: "btn btn-primary",
              form_class: "d-inline" %>
        <%= link_to "Browser print",
              print_browser_item_path(@item),
              class: "btn btn-outline-primary",
              target: "_blank",
              rel: "noopener",
              data: { turbo: false } %>
      </div>
    </div>

    <table class="table">
      <tbody>
        <tr>
          <th>Location</th>
          <td><%= @item.location.presence || "Not specified" %></td>
        </tr>
        <tr>
          <th>Disposition</th>
          <td>
            <span class="badge <%= disposition_badge_class(@item.disposition) %> fs-6"><%= item_disposition_label(@item) %></span>
            <% if @item.expired? && @item.pending? %>
              <span class="badge bg-warning text-dark fs-6">Expired</span>
            <% end %>
          </td>
        </tr>
        <% if @item.owned? %>
          <tr>
            <th>Owned by</th>
            <td>
              <%= @item.claimed_by %>
              <div class="mt-2">
                <%= button_to "Disown",
                      disown_item_path(@item),
                      method: :post,
                      class: "btn btn-outline-warning btn-sm",
                      form: { data: { turbo_confirm: "Reopen this giveaway and remove the owner claim?" } } %>
              </div>
            </td>
          </tr>
        <% elsif @item.claimed_by.present? %>
          <tr>
            <th>Claimed by</th>
            <td><%= @item.claimed_by %></td>
          </tr>
        <% end %>
        <% if @item.giveaway_cancelled? && @item.normalized_cancellation_reason.present? %>
          <tr>
            <th>Cancellation reason</th>
            <td><%= @item.normalized_cancellation_reason %></td>
          </tr>
        <% end %>
        <tr>
          <th>Expires</th>
          <td><%= @item.expiration_date&.strftime("%B %d, %Y") || "N/A" %></td>
        </tr>
        <tr>
          <th>Created</th>
          <td><%= @item.created_at.strftime("%B %d, %Y at %l:%M %p") %></td>
        </tr>
        <tr>
          <th>Slack</th>
          <td><%= @item.posted_to_slack? ? "Posted" : "Not posted" %></td>
        </tr>
      </tbody>
    </table>

    <% if @item.votes.any? %>
      <h5>Votes</h5>
      <div class="mb-3">
        <% Vote.choices.each_key do |choice| %>
          <% count = @item.votes.where(choice: choice).count %>
          <% next if count.zero? %>
          <div class="d-flex align-items-center mb-1">
            <span class="badge <%= vote_badge_class(choice) %> me-2"><%= vote_choice_label(choice) %></span>
            <span class="fw-bold me-2"><%= count %></span>
            <small class="text-muted">
              (<%= @item.voter_usernames_for(choice).join(", ") %>)
            </small>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @item.pending? %>
      <hr>
      <h5>Resolve this item</h5>
      <%= form_with url: resolve_item_path(@item), method: :patch, class: "mb-3" do |f| %>
        <div class="row g-2 align-items-end">
          <div class="col-auto">
            <%= f.label :disposition, class: "form-label" %>
            <%= f.select :disposition, resolve_disposition_options, {}, class: "form-select" %>
          </div>
          <div class="col-auto">
            <%= f.label :claimed_by, "Owner / claimed by", class: "form-label" %>
            <%= f.text_field :claimed_by, class: "form-control", placeholder: "Name (required for I own this)" %>
          </div>
          <div class="col-auto">
            <%= f.submit "Resolve", class: "btn btn-success" %>
          </div>
        </div>
      <% end %>

      <h6 class="mt-3 mb-2">Giveaway actions</h6>
      <%= form_with url: cancel_giveaway_item_path(@item), method: :post, class: "d-flex flex-wrap gap-2 align-items-center mb-3" do |f| %>
        <%= f.text_field :cancellation_reason, class: "form-control form-control-sm", placeholder: "Reason (optional)", style: "max-width: 12rem;" %>
        <%= f.submit "Cancel", class: "btn btn-outline-secondary btn-sm", data: { turbo_confirm: "Cancel this giveaway?" } %>
        <%= button_tag "Cancel and relist",
              type: "submit",
              formaction: cancel_and_relist_item_path(@item),
              formmethod: "post",
              class: "btn btn-outline-primary btn-sm",
              data: { turbo_confirm: "Cancel this listing and open a fresh New Item form?" } %>
      <% end %>
    <% elsif @item.owned? %>
      <hr>
      <h6 class="mb-2">Giveaway actions</h6>
      <div class="mb-3">
        <%= form_with url: cancel_and_relist_item_path(@item), method: :post, class: "d-flex flex-wrap gap-2 align-items-center" do |f| %>
          <%= f.text_field :cancellation_reason, class: "form-control form-control-sm", placeholder: "Reason (optional)", style: "max-width: 12rem;" %>
          <%= f.submit "Cancel and relist", class: "btn btn-outline-primary btn-sm", data: { turbo_confirm: "Cancel this listing and open a fresh New Item form?" } %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-3 d-flex flex-wrap gap-2">
      <%= link_to "Edit", edit_item_path(@item), class: "btn btn-outline-secondary btn-sm" %>
      <% if @item.photo.attached? && AgentSetting.enabled? %>
        <%= button_to "AI Describe", describe_item_path(@item), method: :post, class: "btn btn-outline-info btn-sm" %>
      <% end %>
      <%= link_to "Back", items_path, class: "btn btn-outline-secondary btn-sm" %>
      <%= button_to "Delete", @item, method: :delete, class: "btn btn-outline-danger btn-sm", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>
</div>
