<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="mb-0">Lost+Found</h1>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to "New Item", new_item_path, class: "btn btn-primary" %>
  </div>
</div>

<div class="alert alert-light border mb-4" role="status">
  <div class="fw-semibold mb-2">Lost+Found stats</div>
  <div class="d-flex flex-wrap gap-3">
    <span><strong><%= @stats[:unclaimed] %></strong> unclaimed</span>
    <span><strong><%= @stats[:awaiting_pickup] %></strong> awaiting pickup</span>
    <span><strong><%= @stats[:picked_up] %></strong> picked up</span>
    <span><strong><%= @stats[:promoted] %></strong> promoted to Gunky</span>
  </div>
</div>

<ul class="nav nav-pills mb-4">
  <li class="nav-item">
    <%= link_to "Active", items_path(q: @query.presence), class: "nav-link #{params[:disposition].blank? ? 'active' : ''}" %>
  </li>
  <% lost_found_filter_tabs.each do |label, filter| %>
    <li class="nav-item">
      <%= link_to label, items_path(disposition: filter, q: @query.presence), class: "nav-link #{index_tab_active?(filter) ? 'active' : ''}" %>
    </li>
  <% end %>
</ul>

<% if @query.present? %>
  <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
    <span>
      <%= pluralize(@pagy.count, "item") %> matching <strong>&ldquo;<%= @query %>&rdquo;</strong>
    </span>
    <%= link_to "Clear search", items_path(disposition: params[:disposition].presence), class: "btn btn-sm btn-outline-secondary" %>
  </div>
<% end %>

<% if @items.any? %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @items.each do |item| %>
      <%= render "items/card", item: item %>
    <% end %>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
  </div>
<% else %>
  <div class="text-center py-5">
    <h4 class="text-muted">No items found</h4>
    <% if @query.present? %>
      <p class="text-muted">Nothing matches &ldquo;<%= @query %>&rdquo;. Try fewer or different words.</p>
    <% else %>
      <p><%= link_to "Add the first item", new_item_path %></p>
    <% end %>
  </div>
<% end %>
