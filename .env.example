# Gunky — copy to .env and fill in values:
#   cp .env.example .env
#
# Loaded by dotenv-rails in development and test. Docker Compose also reads .env for
# substitution; web and sidekiq override DATABASE_URL and REDIS_URL for in-container hostnames.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# PostgreSQL. Use localhost:5433 when running Rails on the host (Compose publishes db on 5433).
DATABASE_URL=postgres://gunky:gunky@localhost:5433/gunky_development

# Redis (Sidekiq, cache, Action Cable in production).
REDIS_URL=redis://localhost:6379/0

# Required in production. Generate with: bin/rails secret
SECRET_KEY_BASE=generate-with-bin/rails-secret

# App timezone (Rails time zone and cron). Example: America/Los_Angeles
TZ=America/Los_Angeles

# -----------------------------------------------------------------------------
# Admin activity log
# -----------------------------------------------------------------------------

# Password for /admin/sign_in. Leave blank to disable admin routes (404).
GUNKY_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# URLs and hostnames
# -----------------------------------------------------------------------------

# Public base URLs for each site (used in links and Site.gunky_url / lost_found_url).
# Request Host selects Gunky vs Lost+Found; unknown hosts are treated as Gunky.
GUNKY_URL=http://localhost:3000
LOST_FOUND_URL=http://lostfound.localhost:3000

# Host (or host:port) for image URLs in Slack. Protocol for those URLs unless APP_HOST includes a scheme.
APP_HOST=localhost:3000
APP_PROTOCOL=http

# Full base URL for expiry-outcome links in Slack (falls back to GUNKY_URL when unset).
APP_INTERNAL_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Slack
# -----------------------------------------------------------------------------

# Bot token (chat:write, files:read). Required for polls, lost+found posts, and interactions.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Optional users:read token for member name lookup; defaults to SLACK_BOT_TOKEN when unset.
SLACK_USER_LOOKUP_TOKEN=

# Channel for Gunky giveaway polls.
SLACK_CHANNEL_ID=C0123456789

# Channel for lost+found posts; falls back to SLACK_CHANNEL_ID when unset.
SLACK_LOST_FOUND_CHANNEL_ID=C0987654321

# Signing secret from the Slack app (Interactivity request URL: …/slack/interactions).
SLACK_SIGNING_SECRET=your-signing-secret

# -----------------------------------------------------------------------------
# Error reporting (optional, production only)
# -----------------------------------------------------------------------------

# Sentry DSN or ingest URL; either SENTRY_DSN or SENTRY_ENDPOINT is enough.
SENTRY_DSN=
SENTRY_ENDPOINT=

# -----------------------------------------------------------------------------
# Duplicate hints (optional)
# -----------------------------------------------------------------------------

# Set to any value to reply in an item's Slack thread when similar earlier items exist.
# When unset, CheckDuplicatesJob only logs what it would have posted.
# DUPLICATE_HINTS_ENABLED=true

# Minimum full-text rank (0–1) for a duplicate hint; default 0.2.
# Tune with: bin/rails "gunky:duplicate_hints:report[14]"
# DUPLICATE_HINT_MIN_RANK=0.2

# -----------------------------------------------------------------------------
# AI agent (optional — most settings live in Settings → AI Agent)
# -----------------------------------------------------------------------------

# Timeouts for OpenAI-compatible vision requests (OllamaService / LiteLLM).
# OLLAMA_OPEN_TIMEOUT_SECONDS=5
# OLLAMA_READ_TIMEOUT_SECONDS=90

# -----------------------------------------------------------------------------
# Receipt printing (optional)
# -----------------------------------------------------------------------------

# CUPS server host:port for lp(1) when the app runs in Docker (queue name is in Settings → Thermal printer).
# CUPS_SERVER=host.docker.internal:631
