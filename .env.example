DATABASE_URL=postgres://gunky:gunky@localhost:5432/gunky_development
REDIS_URL=redis://localhost:6379/0
TZ=UTC
SECRET_KEY_BASE=generate-with-bin/rails-secret
# Admin password for the activity log (/admin/sign_in)
GUNKY_ADMIN_PASSWORD=
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_LOOKUP_TOKEN=
SLACK_CHANNEL_ID=C0123456789
SLACK_LOST_FOUND_CHANNEL_ID=C0987654321
SLACK_SIGNING_SECRET=your-signing-secret
GUNKY_URL=http://localhost:3000
LOST_FOUND_URL=http://lostfound.localhost:3000
APP_HOST=localhost:3000
APP_PROTOCOL=http
APP_INTERNAL_URL=http://localhost:3000
SENTRY_DSN=
# Optional: set to any value to reply in an item's Slack thread when earlier items look similar (logs only when unset)
# DUPLICATE_HINTS_ENABLED=true
# Optional: minimum full-text rank (0-1) for a duplicate hint; tune with gunky:duplicate_hints:report
# DUPLICATE_HINT_MIN_RANK=0.2
SENTRY_ENDPOINT=
# Optional: CUPS server for lp(1) when the app runs in Docker (host:port)
# CUPS_SERVER=host.docker.internal:631
